# ════════════════════════════════════════════
# OutreachAI Backend — Environment Variables
# Copy this file to .env for local dev.
# On Railway: paste each key into Settings → Variables
# NEVER commit .env to GitHub.
# ════════════════════════════════════════════

# ── NODE ─────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── SECURITY ─────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-256-bit-random-secret-here

# ── DATABASE ──────────────────────────────────
# MongoDB Atlas → Connect → Drivers → copy the URI
# Format: mongodb+srv://username:password@cluster.mongodb.net/outreachai?retryWrites=true
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/outreachai

# ── AI ────────────────────────────────────────
# console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── GOOGLE MAPS ───────────────────────────────
# console.cloud.google.com → APIs → Places API → Credentials
GOOGLE_MAPS_API_KEY=AIzaSy-your-key-here

# ── WHATSAPP BSP ─────────────────────────────
# 360dialog.com → Account → API Key
DIALOG360_API_KEY=your-360dialog-key-here

# ── YOUR NUMBERS ─────────────────────────────
REPORT_WA_NUMBER=971544007555       # your UAE number (no + sign)
ALBANIA_WA_NUMBER=35568317201       # your Albania number

# ── SOCIAL (optional, add later) ─────────────
BUFFER_ACCESS_TOKEN=your-buffer-token
APIFY_API_TOKEN=your-apify-token

# ── FRONTEND ─────────────────────────────────
# The URL of your deployed frontend (Railway or Vercel)
FRONTEND_URL=https://your-frontend.railway.app
